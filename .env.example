# Everything is optional. Copy these into your own environment; never commit real keys.
PORT=5000
CACHE_TTL=120
COINS_PER_SECTOR=5
FETCH_WORKERS=2
# Comma-separated CoinGecko ids replace Bitcoin, Ethereum and Solana at the top of the page.
# COINS=bitcoin,ethereum,solana,dogecoin
# JSON file mapping a display name to a CoinGecko category id, for example {"Stable": "stablecoins"}
# SECTORS_FILE=sectors.json
# A free CoinGecko "demo" key raises the rate limit. It is sent as a header, never in a URL.
# COINGECKO_API_KEY=
# COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# Local history of past summaries (one SQLite file). HISTORY=0 switches it off.
HISTORY=1
# HISTORY_DB=data/history.sqlite
HISTORY_MIN_INTERVAL=300
# MOCK_DATA=1 serves fixed sample data and makes no network requests.
# MOCK_DATA=1
